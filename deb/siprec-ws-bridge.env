SIP_HOST=0.0.0.0
EXTERNAL_IP=0.0.0.0
SIP_PORTS=5090
BOT_WS_URL=ws://localhost:7860/siprec-ws
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
RTP_TIMEOUT=30s
RECORDING_DIR=/var/lib/siprec-ws-bridge/recordings
BEHIND_NAT=false
LOG_LEVEL=info
LOG_FORMAT=json

# GCS recording upload (optional)
GCS_ENABLED=false
GCS_BUCKET=
GCS_PREFIX=recordings
GCS_SERVICE_ACCOUNT_KEY=
GCS_KEEP_LOCAL=true

# HTTP server for metrics and debug dashboard
HTTP_PORT=8080
